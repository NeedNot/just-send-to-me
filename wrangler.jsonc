{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "just-send-to-me",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "logpush": true,
  "observability": {
    "logs": {
      "invocation_logs": true,
      "enabled": true,
    },
  },
  "vars": {
    "IS_DEV": true,
    "CLOUDFLARE_ACCOUNT_ID": "78382dff1e8ba1ce7ad866cb85aa5f39",
    "R2_FILES_BUCKET": "dev-files-bucket",
    "SMTP_SERVER_NAME": "smtp.zeptomail.com",
    "SMTP_DOMAIN": "justsendto.me",
    "SMTP_USERNAME": "emailapikey",
    "GOOGLE_CLIENT_ID": "1087781101194-7lusmlc7f48eco6v9bmud3487lt6kj5u.apps.googleusercontent.com",
    "R2_ACCESS_KEY_ID": "9d67e3c3e9db13fe86d67fe250d6f9c5",
  },
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dev-db",
      "database_id": "8f5598f0-eca4-46b4-82ee-840d80f6d2b8",
      "remote": true,
      "migrations_dir": "./drizzle",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "dev-files-bucket",
      "binding": "FILES_BUCKET",
      "remote": true,
    },
  ],
  "ratelimits": [
    {
      "name": "FILE_DOWNLOAD_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 300,
        "period": 60,
      },
    },
    {
      "name": "FILE_UPLOAD_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 110,
        "period": 60,
      },
    },
    {
      "name": "GENERAL_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 10,
        "period": 10,
      },
    },
  ],
  "kv_namespaces": [
    {
      "binding": "STRIPE_CHECKOUT",
      "id": "ab775508c37b4a889f0b1638ac1bcea4",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_CREDITS_OBJECT",
        "class_name": "UserCreditsObject",
      },
      {
        "name": "FOLDER_UPLOADS_OBJECT",
        "class_name": "FolderUploadsObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["UserCreditsObject"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["FolderUploadsObject"],
    },
  ],
  "workflows": [
    {
      "name": "FOLDER_FLOW",
      "binding": "FOLDER_FLOW",
      "class_name": "FolderFlow",
    },
  ],
  "env": {
    "production": {
      "vars": {
        "IS_DEV": false,
        "CLOUDFLARE_ACCOUNT_ID": "78382dff1e8ba1ce7ad866cb85aa5f39",
        "R2_FILES_BUCKET": "files-bucket",
        "R2_ACCESS_KEY_ID": "e9282e37543da346d874cb675583d387",
        "SMTP_SERVER_NAME": "smtp.zeptomail.com",
        "SMTP_DOMAIN": "justsendto.me",
        "SMTP_USERNAME": "emailapikey",
        "GOOGLE_CLIENT_ID": "1087781101194-7lusmlc7f48eco6v9bmud3487lt6kj5u.apps.googleusercontent.com",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "prod-db",
          "database_id": "ccba53b2-b9eb-4848-8a8f-a53443ebc987",
          "remote": true,
          "migrations_dir": "./drizzle",
        },
      ],
      "r2_buckets": [
        {
          "bucket_name": "files-bucket",
          "binding": "FILES_BUCKET",
          "remote": true,
        },
      ],
      "ratelimits": [
        {
          "name": "FILE_DOWNLOAD_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 300,
            "period": 60,
          },
        },
        {
          "name": "FILE_UPLOAD_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 110,
            "period": 60,
          },
        },
        {
          "name": "GENERAL_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": {
            "limit": 10,
            "period": 10,
          },
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "USER_CREDITS_OBJECT",
            "class_name": "UserCreditsObject",
          },
          {
            "name": "FOLDER_UPLOADS_OBJECT",
            "class_name": "FolderUploadsObject",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_classes": ["UserCreditsObject"],
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["FolderUploadsObject"],
        },
      ],
      "workflows": [
        {
          "name": "FOLDER_FLOW",
          "binding": "FOLDER_FLOW",
          "class_name": "FolderFlow",
        },
      ],
    },
  },
}
