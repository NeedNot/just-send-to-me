{
  "name": "just-send-to-me",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "types": "wrangler types ./worker/lib/worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
