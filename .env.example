# ---------------------------------------------------------------------------
# Worker secrets. For local dev put these in .dev.vars (or .env); in
# Cloudflare set them with `wrangler secret put <NAME> --env production`.
# Never commit real values.
# ---------------------------------------------------------------------------
R2_SECRET_ACCESS_KEY=

# random, high-entropy: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

GOOGLE_CLIENT_SECRET=

# Cloudflare's always-pass test secret for local dev:
# 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# used for giving users extra credits. x-admin-token header must match this value to give yourself credits
# see worker/hono/routes/admin/handlers.ts
ADMIN_TOKEN=

# use sk_test_/whsec_ values locally; `stripe listen` prints a whsec_ for local forwarding
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Build-time client vars (Vite inlines VITE_* into the browser bundle, so
# they are public). Put them in .env.local.
# ---------------------------------------------------------------------------
# Cloudflare's always-pass test site key for local dev: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# public R2 URL that serves uploaded files (no trailing slash)
VITE_R2_URL=
